    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {"node": ">=22.12.0"}
}
